<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Tiêu đề -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✏️ Chỉnh sửa thông tin giáo viên"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#7B1FA2"
            android:layout_marginBottom="24dp" />

        <!-- Mã giáo viên (readonly) -->
        <EditText
            android:id="@+id/etTeacherCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Mã giáo viên"
            android:enabled="false"
            android:inputType="text"
            android:importantForAutofill="yes"
            android:minHeight="48dp"
            android:backgroundTint="#FF9800"
            android:textColor="#424242"
            android:layout_marginBottom="12dp" />

        <!-- Họ tên -->
        <EditText
            android:id="@+id/etFullName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Họ tên"
            android:inputType="textPersonName"
            android:importantForAutofill="yes"
            android:minHeight="48dp"
            android:backgroundTint="#7B1FA2"
            android:textColor="#424242"
            android:layout_marginBottom="12dp" />

        <!-- Địa chỉ -->
        <EditText
            android:id="@+id/etAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Địa chỉ"
            android:inputType="textPostalAddress"
            android:importantForAutofill="yes"
            android:minHeight="48dp"
            android:backgroundTint="#7B1FA2"
            android:textColor="#424242"
            android:layout_marginBottom="12dp" />

        <!-- Số điện thoại -->
        <EditText
            android:id="@+id/etPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Số điện thoại"
            android:inputType="phone"
            android:importantForAutofill="yes"
            android:minHeight="48dp"
            android:backgroundTint="#7B1FA2"
            android:textColor="#424242"
            android:layout_marginBottom="12dp" />

        <!-- Ngày sinh -->
        <EditText
            android:id="@+id/etDob"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ngày sinh (YYYY-MM-DD)"
            android:inputType="date"
            android:importantForAutofill="yes"
            android:minHeight="48dp"
            android:backgroundTint="#7B1FA2"
            android:textColor="#424242"
            android:layout_marginBottom="24dp" />

        <!-- Nút lưu -->
        <Button
            android:id="@+id/btnUpdateTeacher"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💾 Cập nhật giáo viên"
            android:backgroundTint="#FF9800"
            android:textColor="#FFFFFF"
            android:minHeight="48dp"
            android:layout_marginBottom="12dp" />

        <!-- Nút quay lại -->
        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔙 Quay lại"
            android:backgroundTint="#7B1FA2"
            android:textColor="#FFFFFF"
            android:minHeight="48dp" />
    </LinearLayout>
</ScrollView>
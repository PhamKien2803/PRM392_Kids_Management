<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Tên hoạt động -->
        <EditText
            android:id="@+id/edtUpdateActivity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="🏫 Tên hoạt động"
            android:padding="12dp"
            android:backgroundTint="#0D47A1"
            android:textColor="#000000"
            android:layout_marginBottom="12dp" />

        <!-- Ngày học -->
        <EditText
            android:id="@+id/edtUpdateDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="📅 Ngày học (dd/MM/yyyy)"
            android:padding="12dp"
            android:backgroundTint="#0D47A1"
            android:textColor="#000000"
            android:focusable="false"
            android:clickable="true"
            android:layout_marginBottom="12dp" />

        <!-- Giờ bắt đầu -->
        <EditText
            android:id="@+id/edtUpdateTimeStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="⏰ Giờ bắt đầu (HH:mm)"
            android:padding="12dp"
            android:backgroundTint="#0D47A1"
            android:textColor="#000000"
            android:focusable="false"
            android:clickable="true"
            android:layout_marginBottom="12dp" />

        <!-- Giờ kết thúc -->
        <EditText
            android:id="@+id/edtUpdateTimeEnd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="⏱️ Giờ kết thúc (HH:mm)"
            android:padding="12dp"
            android:backgroundTint="#0D47A1"
            android:textColor="#000000"
            android:focusable="false"
            android:clickable="true"
            android:layout_marginBottom="16dp" />

        <!-- Nút xác nhận -->
        <Button
            android:id="@+id/btnUpdateConfirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💾 Lưu thay đổi"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#43A047"
            android:padding="14dp" />

    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/studentDetailLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- Header -->
    <RelativeLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@android:color/white"
        android:elevation="4dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:text="✕"
            android:textColor="#424242"
            android:textSize="24sp"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Chi tiết học sinh"
            android:textColor="#1976D2"
            android:textSize="20sp"
            android:textStyle="bold" />

    </RelativeLayout>

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/contentLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Student Information -->
            <LinearLayout
                android:id="@+id/studentInfoContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@android:color/white"
                android:layout_marginBottom="16dp"
                android:elevation="2dp">

                <LinearLayout
                    android:id="@+id/studentInfoInner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="#E3F2FD">

                    <TextView
                        android:id="@+id/tvStudentInfoTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thông tin học sinh"
                        android:textColor="#1976D2"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <!-- Student ID -->
                    <LinearLayout
                        android:id="@+id/studentIdRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:id="@+id/tvStudentIdLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Mã học sinh:"
                            android:textColor="#212121"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/tvStudentId"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="HS001"
                            android:textColor="#212121"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Student Name -->
                    <LinearLayout
                        android:id="@+id/studentNameRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:id="@+id/tvStudentNameLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Tên học sinh:"
                            android:textColor="#212121"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/tvStudentName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nguyễn An"
                            android:textColor="#212121"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Class -->
                    <LinearLayout
                        android:id="@+id/classRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:id="@+id/tvClassLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Lớp:"
                            android:textColor="#212121"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/tvClassName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lớp Mầm Xanh"
                            android:textColor="#212121"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Date of Birth -->
                    <LinearLayout
                        android:id="@+id/dobRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:id="@+id/tvDobLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Ngày sinh:"
                            android:textColor="#212121"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/tvDob"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="15/03/2021"
                            android:textColor="#212121"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Buttons -->
<!--                    <LinearLayout-->
<!--                        android:id="@+id/actionButtons"-->
<!--                        android:layout_width="match_parent"-->
<!--                        android:layout_height="wrap_content"-->
<!--                        android:orientation="horizontal"-->
<!--                        android:gravity="center">-->

<!--                        <Button-->
<!--                            android:id="@+id/btnDeleteStudent"-->
<!--                            style="@style/Widget.AppCompat.Button.Borderless"-->
<!--                            android:layout_width="0dp"-->
<!--                            android:layout_height="48dp"-->
<!--                            android:layout_weight="1"-->
<!--                            android:layout_marginEnd="8dp"-->
<!--                            android:text="Xóa học sinh"-->
<!--                            android:textColor="#FFFFFF"-->
<!--                            android:textSize="16sp"-->
<!--                            android:minWidth="64dp"-->
<!--                            android:minHeight="48dp"-->
<!--                            android:padding="12dp"-->
<!--                            app:backgroundTint="#D32F2F"/>-->

<!--                        <Button-->
<!--                            android:id="@+id/btnSaveChanges"-->
<!--                            android:layout_width="0dp"-->
<!--                            android:layout_height="48dp"-->
<!--                            android:layout_weight="1"-->
<!--                            android:layout_marginStart="8dp"-->
<!--                            android:text="Lưu thay đổi"-->
<!--                            android:textColor="#FFFFFF"-->
<!--                            android:textSize="16sp"-->
<!--                            android:minWidth="64dp"-->
<!--                            android:minHeight="48dp"-->
<!--                            android:padding="12dp"-->
<!--                            app:backgroundTint="#2E7D32"/>-->
<!--                    </LinearLayout>-->

                </LinearLayout>

            </LinearLayout>

            <!-- Parents List -->
            <LinearLayout
                android:id="@+id/parentsListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@android:color/white"
                android:elevation="2dp">

                <TextView
                    android:id="@+id/tvParentsListTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Danh sách phụ huynh"
                    android:textColor="#1976D2"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Header table -->
                <LinearLayout
                    android:id="@+id/parentsListHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#E3F2FD"
                    android:padding="12dp"
                    android:layout_marginBottom="1dp">

                    <TextView
                        android:id="@+id/tvOrdinalNumber"
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:text="STT"
                        android:textColor="#1976D2"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                    <TextView
                        android:id="@+id/tvParentNameHeader"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tên phụ huynh"
                        android:textColor="#1976D2"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                    <TextView
                        android:id="@+id/tvPhoneHeader"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="SĐT"
                        android:textColor="#1976D2"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                    <TextView
                        android:id="@+id/tvActionsHeader"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="Thao tác"
                        android:textColor="#1976D2"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                </LinearLayout>

                <!-- Parent items will be added dynamically by the Activity -->

            </LinearLayout>

        </LinearLayout>


    </ScrollView>

</LinearLayout>
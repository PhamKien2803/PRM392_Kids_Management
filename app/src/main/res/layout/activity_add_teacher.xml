<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="#FFFFFF">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Tiêu đề thêm giáo viên -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👩‍🏫 Thêm giáo viên mới"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#7B1FA2"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/edtFullName"
            android:hint="Họ tên"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#7B1FA2"
            android:textColor="#424242"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/edtAddress"
            android:hint="Địa chỉ"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#7B1FA2"
            android:textColor="#424242"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/edtPhone"
            android:hint="Số điện thoại"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="phone"
            android:backgroundTint="#7B1FA2"
            android:textColor="#424242"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/edtDob"
            android:hint="Ngày sinh (YYYY-MM-DD)"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="date"
            android:backgroundTint="#7B1FA2"
            android:textColor="#424242"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnSaveTeacher"
            android:text="💾 Lưu giáo viên"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="#FF9800"
            android:textColor="#FFFFFF" />

        <!-- Nút xem danh sách giáo viên -->
        <Button
            android:id="@+id/btnViewTeachers"
            android:text="📋 Xem danh sách giáo viên"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="#7B1FA2"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnBack"
            android:text="🔙 Quay lại"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="#424242"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</ScrollView>
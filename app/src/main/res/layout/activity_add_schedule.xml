<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="16dp">

    <!-- Nút Back -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="4dp"
        android:background="@android:color/transparent"
        android:src="@android:drawable/ic_menu_revert"
        android:contentDescription="Quay lại"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:tint="#7B1FA2" />

    <!-- Tiêu đề -->
    <TextView
        android:id="@+id/tvAddScheduleTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Thêm lịch học"
        android:textColor="#7B1FA2"
        android:textSize="26sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/cardForm" />

    <!-- Card chứa form -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardForm"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvAddScheduleTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#FFFFFF"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Tên hoạt động -->
            <EditText
                android:id="@+id/edtActivityName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="🏫 Tên hoạt động (VD: Vẽ tranh, Hát...)"
                android:padding="14dp"
                android:backgroundTint="#7B1FA2"
                android:textSize="16sp"
                android:textColor="#424242"
                android:layout_marginBottom="12dp" />

            <!-- Ngày học -->
            <EditText
                android:id="@+id/edtDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="📅 Ngày học (dd/MM/yyyy)"
                android:padding="14dp"
                android:backgroundTint="#7B1FA2"
                android:textColor="#424242"
                android:textSize="16sp"
                android:focusable="false"
                android:layout_marginBottom="12dp" />

            <!-- Giờ bắt đầu -->
            <EditText
                android:id="@+id/edtTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="⏰ Giờ bắt đầu (HH:mm)"
                android:padding="14dp"
                android:backgroundTint="#7B1FA2"
                android:textColor="#424242"
                android:textSize="16sp"
                android:focusable="false"
                android:layout_marginBottom="12dp" />

            <!-- Giờ kết thúc -->
            <EditText
                android:id="@+id/edtTimeEnd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="⏱️ Giờ kết thúc (HH:mm)"
                android:padding="14dp"
                android:backgroundTint="#7B1FA2"
                android:textColor="#424242"
                android:textSize="16sp"
                android:focusable="false"
                android:layout_marginBottom="12dp" />

            <!-- Ghi chú -->
            <EditText
                android:id="@+id/edtNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="📝 Ghi chú (tuỳ chọn)"
                android:padding="14dp"
                android:backgroundTint="#7B1FA2"
                android:textColor="#424242"
                android:textSize="16sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Nút Lưu -->
    <Button
        android:id="@+id/btnSaveSchedule"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Lưu lịch học"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#FF9800"
        android:elevation="10dp"
        android:padding="16dp"
        app:cornerRadius="12dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/cardForm"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnViewSchedules"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="📋 Xem danh sách lịch học"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#7B1FA2"
        android:elevation="10dp"
        android:padding="16dp"
        app:cornerRadius="12dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/btnSaveSchedule"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>